license = "MIT OR Apache-2.0"
description = "Kernel cibernético sovereign, motor federado de Isabella AI Genesis y runtime MD-X4."
repository = "https://github.com/TAMV-ONLINE/tamv-agent"
homepage = "https://tamv.online"
readme = "README.md"
keywords = ["tamv", "sovereign-ai", "isabella-ai", "md-x4", "bookpi"]
categories = ["asynchronous", "cryptography", "network-programming", "science"]

[dependencies]
anyhow = "1.0"
thiserror = "1.0"
base64 = "0.22"
chrono = { version = "0.4", features = ["serde", "clock"] }
rand = "0.8"
uuid = { version = "1.8", features = ["v4", "v7", "serde"] }

serde = { version = "1.0", features = ["derive", "rc"] }
serde_json = "1.0"
toml = "0.8"
prost = "0.12"

sha2 = "0.10"
sha3 = "0.10"
hmac = "0.12"
ed25519-dalek = { version = "2.1", features = ["serde", "rand_core"] }
zeroize = { version = "1.7", features = ["zeroize_derive"] }

tokio = { version = "1.38", features = ["macros", "rt-multi-thread", "time", "signal", "net", "sync", "io-util", "process"] }
tokio-stream = "0.1"
tokio-util = { version = "0.7", features = ["codec"] }
futures-util = "0.3"
reqwest = { version = "0.12", features = ["json", "stream", "rustls-tls"], default-features = false }
tonic = "0.11"

async-trait = "0.1"
parking_lot = "0.12"

tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter", "fmt", "json"] }
tracing-appender = "0.2"

[build-dependencies]
tonic-build = "0.11"

[dev-dependencies]
tokio-test = "0.4"
tempfile = "3.10"
wiremock = "0.6"

[features]
default = ["full"]
full = ["federation", "bookpi-audit", "isabella-cognitive", "rdm-tos-edge"]
federation = ["dep:tonic", "dep:prost"]
bookpi-audit = []
isabella-cognitive = ["dep:async-trait"]
rdm-tos-edge = []

[[bin]]
name = "tamv-agent"
path = "src/main.rs"

[lib]
name = "tamv_agent"
path = "src/lib.rs"

[profile.release]
opt-level = 3
lto = "thin"
codegen-units = 1
panic = "abort"
strip = true
