Bash
#!/usr/bin/env bash
# scripts/run_nexus_pipeline.sh

set -euo pipefail

IMPORTS_DIR="imports"
SOURCES_DIR="sources"
CONFIG_FILE="config/repos_seed.json"
WORKERS=8

echo "=== INICIANDO CONSOLIDACIÓN NEXUS ENTERPRISE ==="
mkdir -p "${IMPORTS_DIR}" "${SOURCES_DIR}" config

if [ ! -f "${CONFIG_FILE}" ]; then
    echo "ERROR: Archivo de inventario ${CONFIG_FILE} no encontrado."
    exit 1
fi

python3 -m tamv_digital_nexus.cli \
    --inventory "${CONFIG_FILE}" \
    --imports-root "${IMPORTS_DIR}" \
    --workspace-root "${SOURCES_DIR}" \
    --workers "${WORKERS}"

echo "=== CONSOLIDACIÓN COMPLETADA ==="
